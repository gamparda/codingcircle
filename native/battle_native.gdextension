[configuration]

entry_symbol = "battle_native_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.x86_64 = "res://native/bin/libbattle_native.linux.x86_64.so"
windows.x86_64 = "res://native/bin/libbattle_native.windows.x86_64.dll"
android.arm64 = "res://native/bin/libbattle_native.android.arm64.so"
android.arm32 = "res://native/bin/libbattle_native.android.arm32.so"
