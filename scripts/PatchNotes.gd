extends RefCounted

# Historical changes reconstructed from version tags; not current balance rules.
const HISTORY := [
	{"version":"v0.29.0","changes":["랭크 대전에 시즌이 생겼습니다. 매달 1일(UTC)에 새 시즌이 시작되고, 랭크 점수가 1000점 쪽으로 절반 돌아가며 승패 기록이 새로 시작됩니다. 시즌의 처음 10판은 점수가 크게 움직이는 배치 경기입니다.", "랭킹 창에 '순위·카드 통계·지난 시즌' 탭이 생겼습니다. 순위는 이번 시즌 기록만 보여 주고, 지난 시즌의 최종 점수·최고 점수·전적은 지난 시즌 탭에 남습니다.", "카드 통계 탭에서 이번 시즌 랭크 대전의 카드별 사용률·금지율·승률을 볼 수 있습니다. 이 기록은 다음 밸런스 조정의 기준이 됩니다.", "전투 카드를 지금 쓸 수 없을 때 나오는 '자원 약 3초' 같은 안내가 유닛·아이콘 그림을 가리지 않도록 그림 아래로 옮겼습니다.", "서버와 앱이 함께 업데이트됩니다."]},
	{"version":"v0.28.3","changes":["전투 화면 위쪽의 어두운 띠를 없앴습니다. 하늘이 화면 맨 위까지 이어지고, 기지 체력바와 경기 시간이 전장 위에 떠서 표시됩니다.", "게임 데이터 업데이트로 적용되며 게임 규칙은 바뀌지 않습니다."]},
	{"version":"v0.28.2","changes":["유닛이 흙길 위를 걷도록 바닥 그림 위치를 고쳤습니다. 길 위로 떠 보이던 진영색 선을 없앴습니다.","v0.28.1에서 하늘 그림이 화면 위쪽의 기지 체력바와 경기 시간을 가리던 문제를 고쳤습니다.", "게임 데이터 업데이트로 적용되며 게임 규칙은 바뀌지 않습니다."]},
	{"version":"v0.28.1","changes":["전장 그래픽을 새로 그렸습니다. 달밤의 하늘과 먼 성, 폐허가 된 성벽, 흙길 바닥이 그림으로 바뀌었습니다.", "양쪽 기지가 고양이 요새 그림이 되고, 체력이 60% 아래로 내려가면 불타는 모습, 25% 아래면 무너진 모습으로 바뀝니다.", "방벽·포탑·발전기·늪이 그림으로 바뀌었습니다. 방벽은 체력이 절반 아래면 부서진 모습이 되고, 상대 진영의 방벽·포탑은 빨간 깃발을 답니다.", "방벽·포탑·발전기 카드에도 그림 아이콘이 생겨 전투·덱 편성·랭크 밴 화면에 표시됩니다.", "게임 데이터 업데이트로 적용되며 게임 규칙은 바뀌지 않습니다."]},
	{"version":"v0.28.0","changes":["덱이 유닛 4종 + 전술 4종으로 늘었습니다. 기존 덱은 비어 있는 칸을 자동으로 채워 그대로 쓸 수 있습니다.", "덱 슬롯이 3개에서 5개로 늘었습니다. 상황별 덱을 미리 짜 두고 바꿔 쓸 수 있습니다.", "전투 단축키가 8개(병력 1~4, 전술 Q·W·E·R)가 됩니다. 단축키를 바꿔 둔 경우 원래 키는 유지되고 새 칸에 4와 R이 붙습니다.", "랭크 대전에 밴이 생겼습니다. 매칭되면 상대 덱 8장이 공개되고, 15초 안에 그중 1장을 골라 이번 경기에서 쓰지 못하게 합니다. 고르지 않으면 금지 없이 시작하고, 금지된 카드는 전투 화면에서 어둡게 잠깁니다.", "밸런스 조정(4+4 덱 기준 자동 대전 약 4만 경기): 검사 체력 82→76, 궁수 비용 60→55·체력 54→64·공격력 11→12, 저격수 비용 70→60·체력 50→65·공격력 28→30, 네크로맨서 비용 100→85·체력 50→65, 해골 체력 36→48, 좀비 체력 150→140·부활 체력 50%→40%.", "전술 조정: 화염구 비용 45→50·피해 45→36·쿨타임 10→12초, 낙뢰 비용 50→55, 빙결 지속 1.5→2초, 발전기 비용 65→75·수입 2.0→1.7, 포탑 비용 50→45·공격력 8→9, 천사 강림 부활 체력 40%→35%.", "축복이 바뀌었습니다: 비용 40→30, 반경 110→140, 지속 5→7초, 공속 +30%→+50%, 그리고 시전 즉시 범위 안 아군의 체력을 최대 체력의 35%만큼 회복합니다.", "AI가 낙뢰를 더 똑똑하게 씁니다(처치할 수 있는 비싼 후열 유닛을 노림). AI 3~8단계의 덱이 4+4로 바뀌어 단계별 난이도를 다시 맞췄습니다.", "서버와 앱이 함께 업데이트됩니다. 업데이트 전 버전으로는 온라인 대전에 들어갈 수 없습니다."]},
	{"version":"v0.27.2","changes":["세로가 긴 화면(16:10 태블릿, 폴더블)에서 전장이 세로로도 넓어져 아래쪽 빈 공간이 생기지 않습니다. 리플레이 화면도 같습니다."]},
	{"version":"v0.27.1","changes":["화면이 16:9보다 넓은 휴대폰에서 좌우 검은 여백 없이 화면 전체를 씁니다. 메뉴·덱 편성·대기실·설정 창이 넓어지고, 전장도 화면 끝까지 펼쳐집니다. 태블릿처럼 세로가 긴 화면도 같은 방식으로 채웁니다.", "휴대폰에서 덱 편성과 대기실 아래쪽 버튼이 화면 밖으로 잘리던 문제를 고쳤습니다. 대기실의 랭크 대전과 랭킹 버튼을 한 줄로 합쳤습니다.", "게임 데이터 업데이트로 적용됩니다."]},
	{"version":"v0.27.0","changes":["덱의 구조물 칸이 \"전술\" 칸이 되어 구조물과 주문을 섞어 3장을 고릅니다. 새 주문 5종이 추가됐습니다.", "낙뢰(50): 반경 70 안에서 가장 튼튼한 적 1기에게 120 피해. 쿨타임 12초.", "화염구(45): 우리 기지에서 날아가 착탄 지점 반경 75의 적 모두에게 45 피해. 멀리 던질수록 늦게 떨어집니다. 쿨타임 10초.", "빙결(40): 반경 90의 적을 1.5초 동안 멈춥니다(이동·공격 불가). 쿨타임 15초.", "축복(40): 반경 110의 아군 공격 속도 5초 동안 +30%. 쿨타임 12초.", "천사 강림(100): 우리 진영에 세라핌이 내려와 가장 최근에 쓰러진 아군 5명을 체력·공격력 40%로 되살립니다. 해골, 이미 되살아난 유닛, 마왕처럼 1기만 둘 수 있는 유닛은 제외. 쿨타임 40초, 한 전투에 2번.", "주문은 전장 어디에나 쓸 수 있고(천사 강림은 우리 진영만), 떨어지기 전에 바닥에 범위가 먼저 표시됩니다. 기지에는 피해를 주지 않습니다.", "AI도 덱에 주문이 있으면 상황에 맞게 사용합니다.", "서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.26.2","changes":["PC 버전 설정의 계정 안내 문구를 지금 기능에 맞게 고쳤습니다. 랭크 대전과 진행도 이어하기는 Android 앱에서 계정으로 로그인해 이용합니다."]},
	{"version":"v0.26.1","changes":["서버가 1년이 지난 신고 기록을 매일 자동으로 삭제합니다(개인정보 처리방침의 보유 기간에 맞춤).", "게임 데이터 업데이트로 적용되며 게임 방식은 바뀌지 않습니다."]},
	{"version":"v0.26.0","changes":["랭크 대전이 열렸습니다. 대기실의 🏆 랭크 대전으로 로그인한 계정끼리 매칭되며, 결과에 따라 랭크 점수(시작 1000점)가 오르내립니다. 처음 10판은 점수가 더 크게 움직입니다. 진행 중인 랭크 대전에서 나가면 패배로 처리됩니다.", "대기실에서 내 랭크 점수·전적·순위를 보고, 랭킹 보기로 상위 20명을 확인할 수 있습니다. 결과 화면에 이번 경기의 점수 변화가 표시됩니다.", "온라인 경기 결과 화면에서 상대를 신고할 수 있습니다(부적절한 닉네임, 비매너 플레이, 부정행위 의심). 경기당 한 번, 하루 10번까지 가능하며 운영자가 확인합니다.", "진행도가 계정에 저장됩니다. 로그인하면 전적·캠페인·덱·업적이 서버에 올라가고, 다른 기기에서 같은 계정으로 로그인하면 이어서 할 수 있습니다. 소리·화면 같은 기기 설정은 기기마다 따로 유지됩니다.", "두 기기에서 따로 진행해 기록이 달라지면 어느 쪽을 쓸지 고르게 하며, 고르지 않은 이 기기의 진행도는 복구용 사본으로 남습니다.", "Android에서 마지막으로 서버가 계정을 확인한 뒤 7일 동안은 서버에 연결되지 않아도 게임을 켜서 플레이할 수 있습니다. 온라인 대전은 연결이 필요합니다.", "서버가 계정·진행도·통계를 매일 백업하고(14일 보관), 저장 파일이 손상되면 가장 최근 백업으로 자동 복구합니다.", "서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.25.0","changes":["Android에서는 Google 계정으로 로그인해야 플레이할 수 있습니다. 앱을 켜면 로그인 화면이 먼저 나오고, 한 번 로그인하면 다음부터는 자동으로 이어집니다.", "처음 로그인하면 닉네임을 정해 계정을 만듭니다. 계정은 만 14세 이상만 만들 수 있습니다.", "로그인과 계정 확인에 서버 연결이 필요합니다. 연결되지 않으면 로그인 화면에서 다시 연결할 수 있습니다.", "PC 버전은 지금처럼 로그인 없이 플레이합니다.", "게임 데이터 업데이트로 적용되며 Android 앱을 다시 설치할 필요는 없습니다."]},
	{"version":"v0.24.0","changes":["Google 계정으로 로그인할 수 있습니다(Android). 설정의 계정 분류에서 로그인하고, 처음이면 닉네임을 정해 계정을 만듭니다. 계정은 만 14세 이상만 만들 수 있습니다.", "로그인은 선택입니다. 게스트도 지금까지처럼 모든 모드를 할 수 있고, 앞으로 나올 랭크 게임에만 계정이 필요합니다.", "계정에는 Google 계정 식별값(암호화해 저장)과 닉네임만 보관하며 이메일·이름·사진은 받지 않습니다. 설정에서 닉네임 변경, 로그아웃, 계정 삭제를 바로 할 수 있습니다.", "Android 앱을 새로 설치해야 합니다. 게임에서 안내하는 새 APK를 받아 덮어 설치하면 기록은 그대로 유지됩니다.", "서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.23.0","changes":["게임 통신을 모두 암호화합니다. 공식 서버에 접속할 때는 서버 인증서도 확인합니다.", "방 채팅을 없앴습니다. 대기실과 전투 화면에 채팅 창이 더 이상 나오지 않습니다.", "보조 서버와 설정의 \"계산 돕기\"를 없앴습니다. 이전 설치본에 남은 보조 서버 실행 파일과 바로가기도 정리합니다.", "서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.22.0","changes":["새 유닛 마왕이 추가됐습니다. 비용 140의 군주 유닛이며 전장에 한 기만 둘 수 있습니다.", "영혼 수확: 마왕 주변(반경 110)에서 적이 쓰러질 때마다 마왕이 최대 체력의 6%를 회복하고 영혼을 하나 얻습니다. 영혼 1개당 공격력이 6% 오르며 최대 8개(+48%)까지 쌓입니다.", "공포의 포효: 16초마다 주변(반경 75)의 적 모두에게 피해를 주고 40만큼 뒤로 밀어냅니다.", "성기사의 신성 피해 1.5배가 언데드뿐 아니라 마족인 마왕에게도 적용됩니다. 늪·방벽·흑마법사도 느린 마왕을 묶어 두는 데 효과적입니다.", "AI 캠페인 8단계(마왕 강림)의 적이 네크로맨서 대신 마왕을 사용하며, 단계 난이도 흐름에 맞게 체력·공격력 배율을 조정했습니다.", "서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.21.2","changes":["모든 유닛·구조물 조합을 다시 평가해 지나치게 강하던 조합은 약하게, 거의 이기지 못하던 조합은 강하게 조정했습니다.", "궁수 비용 55→60, 공격력 12→11, 체력 58→54. 탱커 비용 50→55, 체력 360→350. 성기사 비용 60→65. 저격수 공격력 30→28.", "마법사 비용 25→20, 체력 80→95. 광전사 공격력 6→8. 흑마법사 저주 장판 반경 30→45, 적 공격 속도 감소 25%→30%.", "네크로맨서가 소환하는 해골의 공격력을 10→9로 낮췄습니다. 발전기 비용을 50→65로 올렸습니다.", "AI 캠페인 3·4·7·8단계의 체력·공격력 배율을 다시 맞춰 단계가 오를수록 꾸준히 어려워지도록 했습니다.", "게임 데이터 업데이트로 적용되며 Windows·Android 네이티브 설치 버전은 그대로입니다."]},
	{"version":"v0.21.1","changes":["마법사의 공격 속도 지원을 1회당 3%에서 5%로 올렸습니다. 최대 10회 중첩 시 증가량은 30%에서 50%가 됩니다. 마법사 체력은 60에서 80으로 올렸습니다.", "네크로맨서 비용을 110에서 100으로 낮추고, 소환되는 해골의 체력을 30에서 36으로 올렸습니다.", "상향된 유닛이 포함된 AI 덱에 맞춰 캠페인 3~8단계의 체력·공격력 보정값을 조정했습니다."]},
	{"version":"v0.21.0","changes":["새 유닛 좀비가 추가됐습니다. 처음 쓰러지면 2초 동안 누워 있다가 체력 50%로 한 번 다시 일어납니다. 쓰러진 동안에는 공격받지 않습니다.", "새 유닛 성기사가 추가됐습니다. 20초마다 십자가를 내리찍어 반경 60 안의 적 모두에게 피해를 줍니다. 언데드(좀비·해골)에게는 피해가 1.5배이며, 성기사에게 쓰러진 좀비는 부활하지 못합니다.", "새 유닛 저격수가 추가됐습니다. 사거리가 매우 길고 공격은 느리지만, 사거리 안에서 가장 뒤에 있는 적을 방벽 너머로 노립니다.", "흑마법사의 저주 장판이 적의 공격력 대신 공격 속도를 25% 늦춥니다. 마법사와 포탑에도 적용됩니다.", "유닛이 10종이 되어 덱 편성 카드가 조금 더 작아졌습니다. AI 캠페인 6단계는 좀비, 7단계는 성기사, 8단계는 저격수를 쓰며 단계별 난이도를 다시 맞췄습니다.", "서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.20.6","changes":["궁수의 공격력을 14에서 12로 낮추고 비용을 50에서 55로 올렸습니다.","탱커의 체력을 400에서 360으로 낮추고 비용을 45에서 50으로 올렸습니다. 탱커와 궁수를 함께 쓰는 덱이 다른 덱을 압도하던 격차가 줄어듭니다.","이 변경으로 흔들린 AI 캠페인 3~8단계의 체력·공격력 배율과 추가 수입을 다시 맞췄습니다. 단계가 오를수록 꾸준히 어려워집니다."]},
	{"version":"v0.20.5","changes":["네크로맨서 한 명이 동시에 거느릴 수 있는 해골을 최대 3기로 제한했습니다. 해골이 3기 살아 있으면 그 소환 주기는 건너뛰고, 해골이 쓰러지면 다음 5초 주기에 다시 채웁니다.","네크로맨서의 비용·체력·공격력과 해골 수치, 소환 주기는 그대로입니다."]},
	{"version":"v0.20.0","changes":["전투 중 병력·구조물 상태를 훨씬 자세히 볼 수 있습니다. 전장 병력 현황(역할별 구성·비율, 생산 조건과 자원 회복 예상)과 구조물 현황(설치·체력·남은 수명)을 터치로 열 수 있고, 병력이나 구조물을 클릭·터치하면 체력·공격력·분노·저주·소환 시간 같은 상태를 바로 확인합니다. 겹쳐 있으면 눌러서 순환 선택합니다.","병력 카드나 단축키를 누르고 있으면 반복 생산합니다. 구조물은 방향키·Home/End로 위치를 옮기고 Enter로 설치할 수 있으며, 설치 간격 제한과 만료 임박(늪) 표시가 지도에 나타납니다.","유닛 스탯 창에 분류·검색, 양쪽 출전 덱과 성장 수치 비교가 추가됐고, 다시 열면 검색 조건과 읽던 위치를 복원합니다. 오프라인 전투는 일시정지와 앱 이탈 시 자동 정지로 시간·자원이 흐르지 않도록 보호합니다.","리플레이 보관함이 크게 좋아졌습니다. 진영별 덱 검색, 카드에서 병력 클릭으로 검색, 검색어 개별 해제, 중요한 전투 정리 제외, 보관 용량 안내를 제공하고, 상세 검색은 접어 두어 카드가 바로 보입니다. 큰 보관함은 나눠서 읽어 화면이 멈추지 않습니다.","긴 리플레이도 열 때 화면이 멈추지 않습니다. 시점 이동과 전세 그래프 준비를 여러 프레임으로 나눠 처리하고, 전투 요약에 생존 병력 비교와 탐색 기능이 추가됐습니다.","도전 기록에서 보관한 전투를 페이지로 넘겨 보고 덱으로 검색할 수 있습니다. 진행도 복구 화면은 비교 항목을 접고 펼치거나 변경된 항목만 볼 수 있습니다.","병력 현황·구조물 현황·도전 기록 화면의 긴 안내문이 목록을 가리던 문제를 고쳤습니다. 이제 목록이 먼저 보이고 안내는 아래로 이동했습니다."]},
	{"version":"v0.19.0","changes":["진행도 복구가 훨씬 안전해졌습니다. 복구 전에 닉네임, 도전 기록, 잃게 되는 기록, 시작 목표·튜토리얼, 새 기능 확인 상태가 어떻게 달라지는지 비교해 보여 줍니다. 진행도 사본은 내보내고 가져오고 관리할 수 있습니다.","리플레이 뷰어에 전투 요약이 생겼습니다. 시점별 전투 요약과 선택한 구간의 병력 기여도 비교를 볼 수 있고, 선택한 구간만 공유할 수 있습니다. 보관함 탐색과 공유 코드 입력(길게 붙여 넣은 값을 자르지 않음)도 개선됐습니다.","리플레이를 실수로 지우지 않도록 삭제와 오래된 기록 정리가 영구 삭제 전에 확인창을 거칩니다. 확인창에서 파일 경로와 내용을 보고 복사해 둘 수 있습니다.","일일·주간 도전 기록에서 보관된 전투를 골라 재생할 수 있습니다. 양쪽 덱을 미리 보고 덱 구성으로 검색하며, 재생이 끝나면 원래 목록으로 돌아옵니다.","최근 온라인 전투 목록이 개선됐습니다. 목록 새로고침 때문에 '보기' 요청이 끊기던 문제를 고쳤고, 불러오는 중에 취소할 수 있으며, 재생 후 원래 목록으로 돌아옵니다.","새 기능 안내에서 화면이 열리지 않았는데도 확인 완료로 저장되던 문제를 고쳤습니다. 시간이 손상된 도전 기록은 0초 기록으로 바뀌지 않고 걸러지며, 같은 날의 유효한 이전 버전 기록이 대표 기록으로 남습니다.","리플레이 파일과 서버 기록에 저장 시각 등 선택 항목이 추가됐습니다. 기존 파일과 이전 버전 게임은 그대로 읽을 수 있습니다."]},
	{"version":"v0.18.0","changes":["설정의 데이터 화면에서 진행도를 백업하고 복구할 수 있습니다. 복구할 때는 현재 진행도와 원본을 먼저 보관하고, 결과 전송에 쓰는 설치 정보는 현재 기기의 것을 유지해 중복 집계를 막습니다.","개인 전적의 일일·주간 도전 기록에서 날짜로 검색하고 페이지를 넘기며 키보드로 스크롤할 수 있습니다. 시간이 손상된 기록은 0초 대신 '시간 미상'으로 표시됩니다.","전투가 끝났거나 관전 중이거나 연결을 복구하는 동안에는 병력 생산과 구조물 설치를 막고 이유를 안내합니다. 온라인 입장과 재접속 직후에는 최신 전투 상태를 받은 뒤에 구매할 수 있습니다. 구매 카드에 생산 대기 시간이 표시됩니다.","기지 붕괴 연출 중 재접속하거나 새 경기를 시작해도 이전 연출이 끼어들지 않으며, 재접속해도 같은 결과와 보상이 한 번만 반영됩니다. 구조물 설치 중 터치 오작동과 설치 실패 안내를 개선했습니다.","전투 요약에 전세 그래프가 추가됐습니다. 재접속해도 전세 기록이 이어지고, 수신하지 못한 구간은 추정하지 않고 공백으로 표시합니다. 병력별 피해·처치 비중을 비교하는 카드도 추가됐습니다.","온라인 재경기를 시작해도 이전 결과 화면이 닫히지 않던 문제와 전적의 일일·주간 탭을 열 때 오류가 나던 문제를 고쳤습니다."]},
	{"version":"v0.17.0","changes":["설정, 덱, 전적을 저장하지 못했을 때 성공한 것처럼 안내하던 문제를 고쳤습니다. 저장이 실패하면 오류와 재시도 방법을 알려 주고, 기존 데이터와 입력한 내용은 그대로 유지됩니다.","읽을 수 없거나 손상된 프로필, 더 새로운 버전의 프로필은 원본을 보존하고 안내합니다. 리플레이는 임시 파일에 먼저 쓴 뒤 교체해 같은 초에 저장해도 덮어쓰지 않으며, 잘못된 외부 리플레이는 재생 전에 걸러냅니다. 데이터 초기화와 리플레이 자동 정리도 실제 삭제 결과를 확인합니다.","익명 결과와 도전 점수는 서버가 저장했다고 확인한 뒤에만 대기열에서 지우고, 중복 집계 없이 다시 보냅니다. 통계, 순위표, 도전 점수는 규칙 버전별로 나뉘어 규칙이 바뀌어도 섞이지 않습니다.","서버가 전투 기록을 저장하지 못하면 완성된 기록을 보관해 재시도하고, 저장 장애가 이어지면 새 전투 시작을 잠시 보류합니다. 같은 내용의 공유 리플레이는 같은 코드를 재사용합니다.","개인 전적에서 일일·주간 도전의 버전별 최고 기록을 볼 수 있습니다. 긴 도전 안내에서도 시작·돌아가기 버튼이 유지됩니다.","서버와 클라이언트 통신이 바뀌어 이전 버전 게임은 새 서버에 결과와 점수를 보낼 수 없습니다. 필수 업데이트로 배포됩니다."]},
	{"version":"v0.16.4","changes":["개인 전적 화면을 다시 만들었습니다. AI와 온라인 기록을 요약 카드로 나누어 보여 주고, 캠페인 기록은 단계, 별, 도전, 승, 최단 시간, 최고 기지 HP가 줄 맞춰진 표로 바뀌었습니다. 아직 해 보지 않은 단계는 0.0초 대신 줄표로 표시됩니다.","패치노트는 최근 3개 버전만 펼쳐 보이고, 이전 버전은 버전 이름을 눌러 펼칠 수 있습니다.","결과 화면 아래의 목표 달성과 다음 추천 안내가 어두운 판 위에 표시되어 뒤의 전투 화면과 겹쳐 읽기 어렵던 문제를 고쳤습니다."]},
	{"version":"v0.16.3","changes":["설정에서 전투 단축키를 열면 창이 오른쪽으로 조금 늘어나던 문제를 고쳤습니다. 단축키 버튼이 최소 너비를 넘겨 자리를 차지하던 것이 원인이었고, 이제 남은 너비에 맞게 줄어듭니다."]},
	{"version":"v0.16.2","changes":["설정 화면을 다시 만들었습니다. 오디오, 화면, 전투 연출, 전투 단축키, 계산 돕기, 데이터로 분류를 나누어 한 번에 한 분류만 보여 줍니다. 이전에는 길게 이어진 목록 아래쪽에 숨어 있던 항목들이 이제 바로 보입니다.","화질 선택이 화면 분류 안으로 들어갔고, 변경하면 저장하지 않은 변경이 있다는 표시가 아래에 나타납니다. 설정 저장과 취소는 한 줄로 합쳤고, 저장해야 적용된다는 안내가 맞게 바뀌었습니다.","계산 돕기와 데이터 분류에 간단한 설명을 추가했습니다."]},
	{"version":"v0.16.1","changes":["서버 업데이트가 팩 방식으로 전환됩니다. 이미 최신인 서버도 처음 한 번은 팩으로 바꿔 설치하도록 업데이터를 고쳤습니다.","이 업데이트는 PC에서 설치 파일 없이 게임 데이터만 받아 적용됩니다."]},
	{"version":"v0.16.0","changes":["PC 업데이트가 작아집니다. 이번에 한 번만 새 설치 파일을 받고, 이후 대부분의 업데이트는 6MB 정도의 게임 데이터만 받아 다음 실행 때 적용합니다. 게임을 켠 채로 새 데이터가 나오면 경기가 끝난 뒤 자동으로 다시 시작합니다.","서버 업데이트 방식을 추가했습니다. 서버가 저장소를 통째로 받아 에셋을 다시 만들고 테스트를 돌리는 대신, 검증된 게임 데이터 파일 하나를 받아 해시를 확인하고 교체합니다. 서버 설정에서 켜야 적용됩니다.","업데이트 확인 화면이 실패해도 PC에서는 게임이 멈추지 않고 현재 버전으로 시작합니다."]},
	{"version":"v0.15.4","changes":["하루에 한 번 자동으로 시작하던 정기 밸런스 조사를 없앴습니다. 밸런스 실험은 보조 서버 창의 새 작업 요청으로만 시작합니다.","공유된 리플레이의 자동 검증은 그대로 유지됩니다."]},
	{"version":"v0.15.3","changes":["메인 서버가 스스로 작업을 만들어 나눠 줍니다. 공유된 리플레이는 올라올 때마다 자동으로 다시 재생해 검증하는 작업이 큐에 올라가고, 기록과 다르면 서버 기록과 로그에 표시됩니다.","보조 서버가 연결되어 있으면 하루에 한 번 밸런스 조사를 자동으로 시작합니다. 하루에 한 단계씩 돌아가며 조사하고, 결과는 서버의 jobs 폴더에 저장됩니다.","자동 작업도 같은 규칙을 따릅니다. 도우미가 있으면 도우미가 먼저 맡고, 없으면 메인 서버가 낮은 우선순위로 직접 처리하며, 전투가 많이 돌고 있으면 쉽니다."]},
	{"version":"v0.15.2","changes":["보조 서버가 공식 서버에 연결할 때 게임과 같은 순서로 주소를 시도합니다. 같은 공유기 안에서 도메인이나 공인 IP로 연결되지 않던 문제가 해결됩니다.","보조 서버 창의 제목이 Keepfall 보조 서버로 표시됩니다."]},
	{"version":"v0.15.1","changes":["보조 서버와 계산 돕기에서 토큰을 없앴습니다. 이제 주소만 있으면 연결되며, 새로 설치한 보조 서버는 공식 서버 주소가 미리 입력되어 열면 바로 연결합니다.","설정의 계산 돕기에서 토큰 입력칸이 사라졌습니다. 스위치만 켜면 됩니다.","대신 가벼운 제한을 두었습니다. 도우미는 동시에 32대까지, 보조 서버가 열어 둘 수 있는 작업은 3개까지이며, 계산 돕기는 작업을 요청하지 않고 일만 합니다.","서버에 CATWAR_ASSIST=off를 주면 도우미를 받지 않습니다. 서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.15.0","changes":["보조 서버 프로그램을 추가했습니다. StartAssist.cmd로 실행하면 창이 열리고, 메인 서버에 연결해 받을 작업 종류와 사용할 CPU 코어 수를 고르고, 지금 하는 일과 실시간 로그를 볼 수 있습니다.","메인 서버에 작업 큐를 추가했습니다. 밸런스 실험처럼 큰 계산을 작은 조각으로 나눠 도우미에게 맡기고, 도우미가 없으면 메인 서버가 낮은 우선순위로 직접 처리합니다.","보조 서버의 종료 버튼은 하던 조각을 마무리하고 결과를 보낸 뒤 알립니다. 남은 조각은 메인 서버가 다시 배정하며, 갑자기 꺼져도 일정 시간 뒤 자동으로 회수됩니다.","설정에 계산 돕기를 추가했습니다. 켜 두면 메뉴 화면에서 남는 CPU로 서버의 계산을 돕고, 전투 중에는 쉽니다. 게임과 별도의 연결을 쓰므로 멀티플레이에 영향을 주지 않습니다.","서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다. 보조 기능은 서버에 CATWAR_ASSIST_TOKEN을 설정했을 때만 켜집니다."]},
	{"version":"v0.14.0","changes":["설정 화면에 데이터 전체 초기화를 추가했습니다. 이 기기에 저장된 전적, 진행도, 업적, 덱, 설정, 리플레이, 통계 캐시를 모두 지우고 처음 상태로 돌아갑니다.","실수로 누르지 않도록 지워지는 항목을 먼저 보여 주고, 삭제 버튼은 3초 뒤에 활성화됩니다. 서버에 이미 올라간 기록은 지워지지 않으며 새 익명 ID가 만들어집니다."]},
	{"version":"v0.13.3","changes":["아직 아무도 싸우기 전의 전세는 계산하지 않도록 고쳤습니다. 병력을 먼저 낸 쪽이 앞서 보이다가 상대도 내면 뒤집히는 일이 더 이상 전세 역전으로 표시되지 않습니다.","역전승 판정(결과 화면의 한 줄 요약과 업적)을 엄격하게 했습니다. 크게 밀린 상태가 3초 이상 이어진 뒤에 이겼을 때만 인정됩니다. 초반에 잠깐 앞서다 진 경우의 전세를 내줬다는 요약도 같은 기준입니다."]},
	{"version":"v0.13.2","changes":["서버가 필요한 기능은 직접 접속하지 않아도 알아서 서버에 접속합니다. 리플레이 코드 공유, 코드로 열기, 최근 온라인 전투, 전체 플레이어 통계, 일일·주간 순위표가 해당됩니다.","접속에 실패하면 이유를 안내하고, 잠시 동안은 백그라운드 요청이 다시 접속을 시도하지 않아 오프라인에서도 화면이 느려지지 않습니다."]},
	{"version":"v0.13.1","changes":["Windows에서 한글을 입력하면 한 글자만 남고 다음 글자가 앞 글자를 지우던 문제를 고쳤습니다. 닉네임, 방 이름, 채팅, 리플레이 메모 등 모든 입력창에 적용됩니다.","입력 도중 다른 입력창을 눌러도 마지막 글자가 새 입력창으로 넘어가지 않습니다."]},
	{"version":"v0.13.0","changes":["게임 이름이 Keepfall로 바뀌었습니다. 제목 화면, 시작 화면, 창 제목, Android 앱 이름이 새 이름으로 표시됩니다. 설치 폴더와 저장 파일은 그대로라 기존 기록은 유지됩니다.","드래프트 화면에서 병력 초상이 카드 밖으로 커져 보이던 문제를 고쳤습니다.","서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.12.0","changes":["멀티플레이 방 목록에서 진행 중인 전투를 바로 볼 수 있습니다. 공개 전투 카드에 두 플레이어의 닉네임, 덱, 진행 시간이 표시되고, 전체·대기 중·라이브 전투 필터로 골라 볼 수 있습니다.","메인 메뉴에 시작 목표를 추가했습니다. 첫 승리, 덱 만들기, 일일 도전, 드래프트, 리플레이 보기, 온라인 대전을 하나씩 해 보도록 안내하고, 결과 화면에서 달성한 목표와 다음 추천을 알려 줍니다.","리플레이 뷰어에 구간 반복을 추가했습니다. 시작과 끝 지점을 정하면 그 장면을 계속 돌려 볼 수 있습니다. ( [ ] L 키 )","리플레이에서 유닛을 클릭하면 이름, 진영, 체력, 능력치 정보 패널이 열립니다.","리플레이 화면을 마우스 휠로 확대하고 가운데 버튼으로 끌어 이동할 수 있습니다.","서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.11.0","changes":["주간 도전: 한 주 동안 모두에게 같은 덱과 두 가지 규칙 변형이 주어지는 더 어려운 도전입니다. 주간 순위표와 업적이 있습니다.","드래프트: AI와 번갈아 병력을 뽑아 덱을 만들고 싸웁니다. 먼저 뽑은 병력은 상대가 쓸 수 없습니다.","리플레이를 짧은 코드로 공유하고, 코드로 열고, 서버가 기록한 최근 온라인 전투를 볼 수 있습니다.","리플레이의 장면마다 메모를 남길 수 있습니다. 메모는 타임라인에 표시되고 리플레이와 함께 저장·공유됩니다.","덱 편성 카드에 온라인 전체 플레이어의 선택률과 승률을 표시합니다.","메인 메뉴에 새 기능 안내를 추가했습니다. 아직 써 보지 않은 기능에 NEW 표시가 붙고 목록에서 바로 열 수 있습니다.","기지가 파괴되면 결과 화면 전에 슬로모션으로 무너지는 연출이 나옵니다.","서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.10.0","changes":["덱 분석과 덱 시뮬레이터에 온라인 전체 플레이어의 덱 승률을 표시합니다. 서버가 온라인 대전 결과를 익명 카운터로만 집계하며, 표본이 적은 덱은 순위에서 제외됩니다.","일일 도전에 전체 순위표를 추가했습니다. 오늘의 상위 기록과 내 순위를 볼 수 있습니다.","내 결과 보내기 스위치(기본 꺼짐)를 켜면 캠페인·연습·일일 도전 결과와 일일 점수가 서버로 전송됩니다. 순위표에는 닉네임이 표시됩니다.","서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.9.0","changes":["덱 시뮬레이터: 편성한 덱으로 AI 단계를 골라 자동 전투를 돌려 승률과 약점 팁을 확인합니다.","덱 분석: 저장된 리플레이로 내 덱의 승률과 쓰임새를 모아 봅니다.","업적 12종과 연승 기록, 결과 화면의 업적 알림을 추가했습니다.","고스트 대전: 리플레이 속 상대의 행동을 그대로 재현하는 상대와 겨룹니다. 되감기 실험: 리플레이의 원하는 순간부터 직접 이어서 플레이합니다.","일일 도전: 매일 모두에게 같은 덱·단계·규칙 변형이 주어지고 점수와 연속 클리어가 기록됩니다.","하이라이트 클립: 리플레이의 명장면 앞뒤 10초를 텍스트로 복사해 공유하고, 가져온 클립은 그 구간만 재생합니다.","결과 화면에 전세 한 줄 요약을 추가했습니다."]},
	{"version":"v0.8.1","changes":["온라인 결과 화면에 상대 닉네임·덱 카드와 내 온라인 전적 요약(승·패·무, 승률)을 추가했습니다.","리플레이 뷰어에 전세 그래프와 하이라이트 점프를 추가했습니다. 첫 교전·기지 위기·전세 역전·결정타로 한 번에 이동하고 Space, 방향키, N/P 단축키를 쓸 수 있습니다.","리플레이를 텍스트로 복사하고 클립보드에서 가져올 수 있습니다. AI 연습 전투도 리플레이로 저장됩니다.","화면에 표시되는 유닛 설명과 보상 문구의 수치를 실제 규칙 데이터와 항상 일치하도록 정리했습니다."]},
	{"version":"v0.8.0","changes":["메인 메뉴에 리플레이를 추가했습니다. 저장된 전투를 목록에서 골라 일시정지·0.5~8배속·처음부터·시간 막대 이동으로 다시 볼 수 있습니다.","버튼·카드·결과 화면에 UI 효과음을 추가했습니다.","터치 기기에서 버튼과 슬라이더가 손가락 크기로 커집니다.","빠른 대전에 대기 시간 표시와 오래 기다릴 때의 AI 캠페인 안내를 추가했습니다.","덱 편성 화면을 새 구조로 옮겼고, 내부 코드를 정리했습니다."]},
	{"version":"v0.7.2","changes":["제목과 큰 숫자에 한글 디스플레이 글꼴(Black Han Sans)을 적용했습니다.","대기실을 플레이어 카드(아바타·준비 상태·덱 초상)와 방 코드 복사 버튼으로 새로 디자인했습니다.","온라인 전투의 이름표·지연 표시·연결 복구 안내를 알약형 알림으로 바꿨습니다.","전투 시작 배너와 타격·피해 숫자 연출, 기지 창문과 깃발 애니메이션을 추가했습니다.","로비 방 카드에 상태 칩과 인원 표시를 추가했습니다."]},
	{"version":"v0.7.1","changes":["전체 화면 UI를 새 테마로 개편했습니다. 슬라이더·토글·드롭다운과 버튼에 그라데이션과 호버 연출을 적용했습니다.","메인 메뉴에 유닛 쇼케이스와 애니메이션 배경을 추가했습니다.","전투 화면의 체력 바·타이머·자원 바·유닛 카드와 전장 배경을 다시 디자인했습니다.","덱 편성 카드에 유닛 초상을 넣고, 캠페인 단계 타일과 결과 화면(별 연출), 유닛 스탯 화면을 개선했습니다.","일부 안내문에 남아 있던 낡은 수치(마법사 쿨타임 등)를 실제 데이터 기준으로 바로잡았습니다."]},
	{"version":"v0.7.0","changes":["로비에 빠른 대전 버튼을 추가했습니다. 대기열에서 두 플레이어가 자동으로 매칭되어 바로 시작하며 언제든 취소할 수 있습니다.","온라인 전투와 AI 캠페인 전투를 명령 기록으로 저장하는 리플레이 기록을 추가했습니다.","AI 캠페인은 고정 간격으로 진행되어 기기 성능과 무관하게 같은 결과를 냅니다.","서버와 클라이언트를 함께 업데이트해야 접속할 수 있습니다."]},
	{"version":"v0.6.5","changes":["광전사 기본 공격력을 13에서 6으로 낮췄습니다.","체력 50% 이하의 광폭화는 공격력 6을 유지하며 공격속도만 50% 증가합니다. 체력·비용·캠페인 성장·저주 적용은 유지합니다."],"source_tag":"","source_commits":[]},
	{"version":"v0.6.4","changes":["병력 비용을 탱커 45·궁수 50·마법사 25·흑마법사 35·네크로맨서 110으로 조정했습니다. 검사 공격력은 11, 궁수는 14, 흑마법사는 4입니다.","마법사의 지원 주기를 7초에서 4초로 줄였습니다. 공속 +3% 누적·최대 +30%는 유지합니다.","동시 공격을 함께 판정해 진영·유닛 처리 순서에 따른 선공 이점을 줄였습니다. 양쪽 기지가 동시에 파괴되면 무승부가 됩니다.","AI 1~8단계의 덱·병력·수입·구매 주기를 조정하고 필요한 병력 구매 직전에 자원을 낭비하던 행동을 개선했습니다."],"source_tag":"","source_commits":["da6813d feat(balance): add engine tournaments and tune units and eight-stage AI"]},
	{"version":"v0.6.3","changes":["설정에서 병력 3칸과 구조물 3칸의 전투 단축키를 변경할 수 있습니다.","중복 키와 예약 키를 차단하고 기본값 복원·변경 취소·저장을 제공합니다. 전투 카드에도 변경한 키가 표시됩니다.","기존 저장 파일은 1·2·3 / Q·W·E를 유지합니다. 채팅 입력·관전·결과 화면의 단축키 차단도 유지합니다."],"source_tag":"","source_commits":[]},
	{"version":"v0.6.2","changes":["연습에 일시정지·0.5/1/2/4배속·즉시 초기화·상대 덱 설정·무제한 자원을 추가했습니다. 실험 설정은 캠페인 진행과 전적에 반영하지 않습니다.","캠페인 시작 전 상대 덱·단계별 전술 목표·정확한 별 조건·최고 기록을 확인할 수 있습니다. 결과에서 조건별 달성 여부를 표시합니다.","항복은 확인 후 서버가 패배로 처리하며 같은 방의 결과·재대전 흐름을 유지합니다. 관전자는 항복할 수 없습니다.","서버 왕복 지연과 상대 이름을 전투 중 표시합니다. 일시적인 연결 끊김은 20초 동안 전투를 정지하고 자동 복귀를 시도합니다."],"source_tag":"","source_commits":[]},
{
