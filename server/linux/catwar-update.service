[Unit]
Description=Check and deploy tested Cat War server releases
Documentation=https://github.com/gamparda/codingcircle
After=network-online.target catwar-server.service
Wants=network-online.target

[Service]
Type=oneshot
# Install this file separately from the replaceable application checkout, owned by root.
ExecStart=/usr/local/libexec/catwar/update-server.sh
EnvironmentFile=/etc/catwar/server.env
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=768M
