<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the game hand a verified update APK to the system installer (the user still confirms). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <!-- Registers the plugin with Godot (v2 plugin architecture). -->
        <meta-data
            android:name="org.godotengine.plugin.v2.KeepfallUpdater"
            android:value="kr.ruellyya.keepfall.updater.KeepfallUpdater" />
    </application>
</manifest>
